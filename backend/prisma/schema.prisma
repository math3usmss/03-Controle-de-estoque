generator client {
	provider = "prisma-client"
	output   = "../src/generated/prisma"
}

datasource db {
	provider = "postgresql"
}


model Product {
  id          String    @id @default(uuid())

  name        String
  description String?
  price       Float
  quantity    Int

  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id        String    @id @default(uuid())

  name      String
  color     String?

  products  Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

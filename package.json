{
  "name": "starter-fullstack",
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "pnpm --parallel --filter next --filter nest dev",
    "build": "pnpm --recursive build",
    "check": "pnpm --recursive check",
    "lint": "pnpm --recursive lint",
    "format": "pnpm --recursive format",
    "prepare": "husky",
    "lint-staged": "lint-staged --max-arg-length 7000"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
